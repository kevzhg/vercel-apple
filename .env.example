# Company Branding
# Replace these with your actual company colors in CSS format
NEXT_PUBLIC_PRIMARY_COLOR=#0ea5e9
NEXT_PUBLIC_SECONDARY_COLOR=#ef4444

# Snowflake OAuth Configuration
# For browser-based authentication (Google SSO support)
SNOWFLAKE_ACCOUNT=your-account.snowflakecomputing.com
SNOWFLAKE_USER=your-username
SNOWFLAKE_WAREHOUSE=your-warehouse
SNOWFLAKE_DATABASE=your-database
SNOWFLAKE_SCHEMA=your-schema
NEXT_PUBLIC_SNOWFLAKE_CLIENT_ID=your_oauth_client_id
NEXT_PUBLIC_SNOWFLAKE_REDIRECT_URI=http://localhost:3000/api/snowflake/callback

# Optional: API endpoints for data processing
# NEXT_PUBLIC_API_URL=
